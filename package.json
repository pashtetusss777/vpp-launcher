{
  "name": "vanilla-plus-plus",
  "productName": "Vanilla++",
  "version": "1.1.6",
  "description": "Лаунчер Vanilla++ для ванильного Minecraft",
  "main": "src/main/main.js",
  "private": true,
  "author": {
    "name": "Vanilla++",
    "email": "pashtetusss777@users.noreply.github.com"
  },
  "license": "GPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "setup": "electron src/setup/main.js",
    "icon": "java scripts/MakeIcon.java",
    "dist": "node scripts/dist.js",
    "dist:dir": "electron-builder --win --dir",
    "build:mac": "electron-builder --mac pkg zip",
    "dist:linux": "electron-builder --linux AppImage deb pacman tar.gz",
    "test:install": "node scripts/test-install.js"
  },
  "build": {
    "appId": "dev.vanilla.plus",
    "productName": "Vanilla++",
    "artifactName": "VanillaPlusPlus-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/main/**/*",
      "src/renderer/**/*",
      "src/setup/uninstall.html",
      "src/setup/uninstall.js",
      "src/setup/uninstall-preload.js",
      "src/setup/setup.css",
      "src/setup/assets/backdrop.jpg",
      "build/icon.png",
      "package.json",
      "launcher.config.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "dir"
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "target": [
        "pkg",
        "zip"
      ],
      "identity": null
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game",
      "executableName": "VanillaPlusPlus",
      "target": [
        "AppImage",
        "deb",
        "pacman",
        "tar.gz"
      ],
      "artifactName": "VanillaPlusPlus-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  }
}
